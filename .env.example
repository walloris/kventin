# URL страницы для тестирования (обязательно)
START_URL=https://example.com
# Опция: перебор URL при петле редиректов (по умолчанию выкл. — поведение как у обычного page.goto)
# START_URL_TRY_REDIRECT_FALLBACKS=1
# С START_URL_TRY_REDIRECT_FALLBACKS=1: после твоего URL и варианта без / пробуются:
# START_URL_FALLBACKS=https://example.com/,https://example.com/login

# --- Local OpenAI-compatible LLM ---
# Единственный LLM-путь. Старые внешние провайдеры отключены.
# Можно указать base URL:
LOCAL_LLM_API_URL=http://127.0.0.1:3333/v1
# Или полный endpoint:
# LOCAL_LLM_API_URL=http://127.0.0.1:3333/v1/chat/completions
# Пусто = агент возьмёт первую модель из GET /v1/models.
LOCAL_LLM_MODEL=
# Обычно локально не нужен, но OpenAI-compatible серверы ждут Bearer.
LOCAL_LLM_API_KEY=local
LLM_REQUEST_TIMEOUT_SEC=60
# Мягкие ретраи transport/408/409/425/429/5xx с exponential backoff + jitter.
LLM_RETRY_COUNT=3
LLM_RETRY_BASE_DELAY=1.0
LLM_RETRY_MAX_DELAY=20.0
# После N неуспешных chat-вызовов временно использовать локальную policy.
LLM_CIRCUIT_BREAKER_AFTER_N_TIMEOUTS=2
LLM_CIRCUIT_BREAKER_COOLDOWN_SEC=60
# Если локальный Node-прокси падает с SELF_SIGNED_CERT_IN_CHAIN, это чинится в запуске прокси:
# NODE_EXTRA_CA_CERTS=/path/to/corporate-ca.pem node proxy.js
# Временный небезопасный обход только для локальной отладки:
# NODE_TLS_REJECT_UNAUTHORIZED=0 node proxy.js

# Jira (опционально; без этого агент может запускаться, но не создаст тикеты)
# JIRA_URL=https://your-company.atlassian.net
# JIRA_USERNAME=your_username
# JIRA_EMAIL=your@email.com
# JIRA_API_TOKEN=your_jira_api_token
# JIRA_PROJECT_KEY=PROJ
# SSL-проверка Jira. Для внутренних стендов с корпоративным TLS можно поставить 0.
# JIRA_VERIFY_SSL=1
# Имена приоритетов: как в Jira (Project → Priorities), на корп. Jira Server часто
# НЕТ «Highest/High/Medium» от Atlassian Cloud. Пусто = не указывать priority
# (Jira поставит приоритет по схеме по умолчанию).
# JIRA_PRIORITY_CRITICAL=
# JIRA_PRIORITY_MAJOR=
# JIRA_PRIORITY_MINOR=
# JIRA_RETRY_COUNT=4
# JIRA_RETRY_BASE_DELAY=1.0
# JIRA_RETRY_MAX_DELAY=20.0
# Ограниченный exploratory-прогон перед генерацией тест-кейсов для задачи (0 = отключить).
# JIRA_TASK_EXPLORATORY_STEPS=20

# Ретест тикетов Kventin и тестирование задач: python daemon.py [--once]
# Имена статусов и резолюции должны совпадать с workflow проекта Jira.
# JIRA_RETEST_STATUS_READY_FOR_QA=Ready for QA
# JIRA_RETEST_STATUS_QA=QA
# JIRA_RETEST_STATUS_IN_PROGRESS=In Progress
# JIRA_RETEST_STATUS_RESOLVED=Resolved
# JIRA_RETEST_RESOLUTION_FIXED=Fixed
# JIRA_RETEST_MAX_ISSUES=20
# Если из истории не найти, кто перевёл в Ready for QA — кого назначить при возврате в In Progress
# JIRA_RETEST_FALLBACK_ASSIGNEE=

# --- Демон (python daemon.py): ретест дефектов + тестирование задач раз в 15 минут ---
# Интервал между прогонами (сек), по умолчанию 900 = 15 минут
# DAEMON_INTERVAL_SEC=900
# Файл блокировки единственного экземпляра демона
# DAEMON_LOCK_FILE=./.kventin-daemon.lock
# Статус ЗАДАЧ (не дефектов), которые демон берёт на тестирование + генерацию тест-кейсов.
# Пусто = тестирование задач отключено, демон делает только ретест дефектов.
# JIRA_DAEMON_TASK_STATUS=Ready for QA
# Сколько задач обрабатывать за прогон
# JIRA_DAEMON_TASK_MAX=10
# Каталог артефактов doc-as-code (тест-кейсы XML и т.д.)
# DOC_AS_CODE_DIR=doc-as-code
# Каталог скиллов (test-case-writer и др.); пусто = <repo>/skills
# LLM_SKILLS_DIR=

# Движок браузера Playwright: chromium | firefox | webkit
# BROWSER_ENGINE=chromium
# Использовать установленный Chrome/Edge, если bundled Chromium не установлен.
# BROWSER_CHANNEL=chrome
# Явный путь к executable имеет приоритет над BROWSER_CHANNEL.
# BROWSER_EXECUTABLE_PATH=
# Размер окна браузера (по умолчанию Full HD — на весь экран)
# VIEWPORT_WIDTH=1920
# VIEWPORT_HEIGHT=1080

# Опционально: замедление браузера (мс), чтобы видеть действия
BROWSER_SLOW_MO=300
# Пауза после подсветки элемента (мс)
HIGHLIGHT_DURATION_MS=800
# Чеклист: пауза между шагами (мс) — агент идёт медленнее по пунктам
CHECKLIST_STEP_DELAY_MS=2000
# Ожидание загрузки: таймаут networkidle (мс)
WAIT_NETWORK_IDLE_MS=5000

# --- Качество тестирования ---
# Тест-план в начале сессии по скриншоту (true/false)
ENABLE_TEST_PLAN_START=true
# Оракул после действий: достигнут ли ожидаемый результат (true/false)
ENABLE_ORACLE_AFTER_ACTION=true
# Второй проход перед дефектом: «это точно баг?» — меньше ложных тикетов (true/false)
ENABLE_SECOND_PASS_BUG=true
# Повторы при сбое действия (0 = без повторов, 1–3 рекомендуется)
ACTION_RETRY_COUNT=2
# Печатать отчёт сессии каждые N шагов (0 = только при дефектах)
SESSION_REPORT_EVERY_N=0
# Сохранять отчёт в файл каждые N шагов во время работы (0 = только в конце)
# SESSION_REPORT_SAVE_EVERY_N=10
# Таймаут ответа LLM (сек): если не ответила — берётся fast action (0 = без лимита)
# LLM_RESPONSE_TIMEOUT_SEC=20
# Таймаут одного действия Playwright (клик, fill), мс
# ACTION_TIMEOUT_MS=10000
# В бесконечном режиме восстанавливать упавшую browser session.
# AGENT_CONTINUOUS_RESTART=true
# AGENT_RESTART_BASE_DELAY_SEC=2.0
# AGENT_RESTART_MAX_DELAY_SEC=60.0
# Путь к файлу итогового отчёта сессии (пусто = только в консоль)
# SESSION_REPORT_PATH=./session_report.txt
# Красивый HTML-отчёт (создаётся папка screenshots рядом с файлом для скриншотов шагов)
# SESSION_REPORT_HTML_PATH=./session_report.html
# JSONL-лог шагов (одна строка JSON на шаг)
# SESSION_REPORT_JSONL=./session_steps.jsonl
# Папка для скриншотов каждого шага (если не задан SESSION_REPORT_HTML_PATH)
# SAVE_STEP_SCREENSHOTS_DIR=./kventin_steps
# Оракул только при изменении экрана или новых ошибках (true = меньше вызовов LLM)
# ORACLE_ON_VISUAL_OR_ERROR=true
# Критический сценарий: приоритетные шаги через запятую
# CRITICAL_FLOW_STEPS=Открыть меню, Клик Контакты, Заполнить форму
# Кнопки баннера cookies/согласия (текст через запятую)
# COOKIE_BANNER_BUTTON_TEXTS=Принять,Accept,Согласен,ОК,Понятно,Cookies
# CI/CD: в CI/GITHUB_ACTIONS/GITLAB_CI по умолчанию headless. Exit 1 если дефектов > N (0 = при любом, -1 = не падать)
# FAIL_ON_DEFECTS=-1
# Оверлеи, которые НЕ часть приложения (чат, поддержка): не тестируем. Паттерны в id/class/тексте через запятую.
# OVERLAY_IGNORE_PATTERNS=chat,чат,support,поддержк,jivo,intercom,crisp,drift,консультант
# Периодичность проверок; 0 отключает конкретную проверку.
# A11Y_CHECK_EVERY_N=10
# PERF_CHECK_EVERY_N=15
# IFRAME_CHECK_EVERY_N=20
# RESPONSIVE_CHECK_EVERY_N=30

# --- Дополнительные фичи ---
# Visual regression: папка с baseline-скриншотами (первый прогон сохраняет, следующие сравнивают)
# VISUAL_BASELINE_DIR=./visual_baseline
# VISUAL_REGRESSION_THRESHOLD_PCT=5.0
# Экспорт сессии в Playwright .py скрипт
# PLAYWRIGHT_EXPORT_PATH=./session_script.py
# Сбор XHR/fetch в отчёт (true/false)
# ENABLE_API_INTERCEPT=true
# API_LOG_MAX=100
# Flakiness: повторных прогонов при сбое (0 = выкл, 2–5 типично)
# FLAKINESS_RERUN_COUNT=0
# Спецификация теста YAML (сценарии до автономного прохода)
# TEST_SPEC_YAML_PATH=./test_spec.yaml
# Несколько стартовых URL через запятую (приоритет над START_URL)
# START_URLS=https://example.com/page1,https://example.com/page2
# DOM diff после клика: детекция мёртвого клика (true/false)
# ENABLE_DOM_DIFF_AFTER_ACTION=true
# Утверждения на естественном языке (проверка через LLM после шагов), через запятую
# NL_ASSERTIONS=После логина видна фамилия пользователя
